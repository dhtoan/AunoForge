{
  "name": "aunoforge-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "find packages -type d -name dist -prune -exec rm -rf {} +",
    "build": "tsc -b packages/*/tsconfig.json",
    "typecheck": "tsc -b packages/*/tsconfig.json --pretty false",
    "test": "npm run build && node --test packages/*/test/*.test.mjs test/*.test.mjs",
    "lint": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3"
  }
}
